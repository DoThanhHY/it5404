{
 "uid": "it5404-autoscale",
 "title": "IT5404 – Autoscaling overview",
 "refresh": "5s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "schemaVersion": 39,
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "CPU trung bình nhóm app (%) – ngưỡng 80/20",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "max": 100
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "app:cpu_util:avg1m",
     "legendFormat": "avg"
    },
    {
     "refId": "B",
     "expr": "vector(80)",
     "legendFormat": "scale-out"
    },
    {
     "refId": "C",
     "expr": "vector(20)",
     "legendFormat": "scale-in"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Số máy ảo app (đang được giám sát / mong muốn)",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "count(up{job=\"node\"}==1)",
     "legendFormat": "healthy targets"
    },
    {
     "refId": "B",
     "expr": "autoscaler_desired_instances",
     "legendFormat": "desired"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "CPU từng máy ảo (%)",
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "max": 100
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "instance:cpu_util:avg1m",
     "legendFormat": "{{instance}}"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Request/s vào /work",
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "app:http_rps:1m",
     "legendFormat": "app RPS"
    },
    {
     "refId": "B",
     "expr": "sum(rate(haproxy_frontend_http_requests_total{proxy=\"web\"}[1m]))",
     "legendFormat": "HAProxy RPS"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Latency p95 (s)",
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "app:http_p95_seconds:1m",
     "legendFormat": "p95"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Lỗi HTTP 5xx qua HAProxy",
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(haproxy_frontend_http_responses_total{proxy=\"web\",code=\"5xx\"}[1m]))",
     "legendFormat": "5xx/s"
    }
   ]
  }
 ]
}